# Spotify developer app credentials. Metadata lookup is disabled without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Exact callback URL registered in the Spotify developer dashboard.
# Example: https://your-service.up.railway.app/api/auth/callback
SPOTIFY_REDIRECT_URI=
PUBLIC_BASE_URL=

# Persistent Railway volume should be mounted at this path.
DATA_DIR=/data

# Resource and retention limits
MAX_UPLOAD_BYTES=209715200
MAX_TRACKS_PER_JOB=300
MAX_ENCODERS=2
MAX_JOB_STORAGE_BYTES=8589934592
MAX_TOTAL_STORAGE_BYTES=21474836480
FFMPEG_TIMEOUT_SECONDS=1800
RETENTION_DAYS=7
LOG_LEVEL=INFO
